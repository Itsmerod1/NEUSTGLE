# NEUSTGLE environment settings
# 1) Copy this file and rename the copy to:  .env
# 2) Fill in the values from your Supabase dashboard (see SETUP.md)
# NEVER share or upload your real .env file.

APP_ENV=development

# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase > Project Settings > API > Legacy API keys > "anon" key (safe for the browser)
SUPABASE_ANON_KEY=PASTE_ANON_KEY_HERE

# Supabase > Project Settings > API > Legacy API keys > "service_role" key (SECRET - backend only)
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE

# Supabase > Project Settings > JWT Keys > Legacy JWT Secret (SECRET - backend only)
SUPABASE_JWT_SECRET=PASTE_JWT_SECRET_HERE
